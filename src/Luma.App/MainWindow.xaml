<Window
    x:Class="Luma.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LUMA">
    <Grid x:Name="RootGrid" Background="#101116">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="28,22,28,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="11" Background="#D9E4FF">
                    <TextBlock Text="L" Foreground="#171923" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="0">
                    <TextBlock Text="LUMA" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold" CharacterSpacing="180"/>
                    <TextBlock Text="WINDOWS EXPERIENCE" Foreground="#858A9B" FontSize="9" CharacterSpacing="110"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="FOUNDATION PREVIEW" Foreground="#858A9B" FontSize="10" CharacterSpacing="120" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Padding="28,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#191B24" CornerRadius="22" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="WORKSPACE" Foreground="#74798B" FontSize="10" CharacterSpacing="130" Margin="10,8,0,10"/>
                    <Button Content="⌂   Overview" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Home_Click"/>
                    <Button Content="▦   Applications" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Applications_Click"/>
                    <Button Content="◈   Widgets" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Widgets_Click"/>
                    <Button Content="⚙   Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Settings_Click"/>
                    <Border Height="1" Background="#30323D" Margin="8,18"/>
                    <TextBlock Text="SYSTEM STATUS" Foreground="#74798B" FontSize="10" CharacterSpacing="130" Margin="10,0,0,2"/>
                    <TextBlock Text="Explorer integration: disabled" Foreground="#A8ADBC" FontSize="11" TextWrapping="Wrap" Margin="10,4"/>
                    <TextBlock Text="Safe development mode" Foreground="#7ED6B1" FontSize="11" Margin="10,0"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" Padding="28,8,8,8">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="EyebrowText" Text="YOUR WINDOWS, REIMAGINED" Foreground="#9DA8C8" FontSize="11" CharacterSpacing="160"/>
                        <TextBlock x:Name="HeadingText" Text="A calmer way to work." Foreground="#F5F6FA" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DescriptionText" Text="LUMA is the foundation for a more coherent Windows desktop. This preview establishes the native shell host and its core navigation." Foreground="#A8ADBC" FontSize="15" MaxWidth="720" TextWrapping="Wrap" LineHeight="24"/>
                    </StackPanel>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1B1E29" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="8"><TextBlock Text="01" Foreground="#9DA8C8" FontSize="12"/><TextBlock Text="Desktop" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Surface and workspace layer" Foreground="#9298AA" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1B1E29" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="8"><TextBlock Text="02" Foreground="#9DA8C8" FontSize="12"/><TextBlock Text="Dock" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Pinned and active apps" Foreground="#9298AA" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#1B1E29" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="8"><TextBlock Text="03" Foreground="#9DA8C8" FontSize="12"/><TextBlock Text="Spotlight" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Search and quick actions" Foreground="#9298AA" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="#202330" CornerRadius="18" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="FOUNDATION MILESTONE" Foreground="#9DA8C8" FontSize="10" CharacterSpacing="140"/>
                            <TextBlock Text="Native shell host initialized" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="The current build is an application preview. It does not replace Explorer, alter system startup, or take ownership of the Windows desktop." Foreground="#A8ADBC" FontSize="13" TextWrapping="Wrap" LineHeight="21"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="#191B24" Padding="20,12">
            <Grid>
                <TextBlock Text="LUMA • FOUNDATION" Foreground="#858A9B" FontSize="10" CharacterSpacing="100" VerticalAlignment="Center"/>
                <TextBlock Text="SAFE MODE  /  EXPLORER UNTOUCHED" Foreground="#7ED6B1" FontSize="10" CharacterSpacing="80" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
