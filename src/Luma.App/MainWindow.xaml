<Window
    x:Class="Luma.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LUMA">
    <Grid x:Name="RootGrid" Background="#101116">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="28,22,28,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="11" Background="#D9E4FF">
                    <TextBlock Text="L" Foreground="#171923" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="0">
                    <TextBlock Text="LUMA" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold" CharacterSpacing="180"/>
                    <TextBlock Text="WINDOWS EXPERIENCE" Foreground="#858A9B" FontSize="9" CharacterSpacing="110"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="⌕  Search" Margin="0,0,14,0" Click="Spotlight_Click"/>
            <TextBlock Grid.Column="2" Text="FOUNDATION PREVIEW" Foreground="#858A9B" FontSize="10" CharacterSpacing="120" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="WorkspaceRoot" Grid.Row="1" Padding="28,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image x:Name="WorkspaceWallpaper" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.32" IsHitTestVisible="False"/>
            <Border Grid.Column="0" Background="#191B24" CornerRadius="22" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="WORKSPACE" Foreground="#74798B" FontSize="10" CharacterSpacing="130" Margin="10,8,0,10"/>
                    <Button Content="⌂   Overview" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Home_Click"/>
                    <Button Content="▤   Desktop" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Desktop_Click"/>
                    <Button Content="▣   Windows" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Windows_Click"/>
                    <Button Content="▧   Files" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Files_Click"/>
                    <Button Content="▦   Applications" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Applications_Click"/>
                    <Button Content="◈   Widgets" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Widgets_Click"/>
                    <Button Content="⚙   Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Settings_Click"/>
                    <Border Height="1" Background="#30323D" Margin="8,18"/>
                    <TextBlock Text="SYSTEM STATUS" Foreground="#74798B" FontSize="10" CharacterSpacing="130" Margin="10,0,0,2"/>
                    <TextBlock Text="Explorer integration: disabled" Foreground="#A8ADBC" FontSize="11" TextWrapping="Wrap" Margin="10,4"/>
                    <TextBlock Text="Safe development mode" Foreground="#7ED6B1" FontSize="11" Margin="10,0"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" Padding="28,8,8,8">
                <StackPanel Spacing="22">
                    <StackPanel x:Name="DesktopPanel" Visibility="Collapsed" Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PERSONAL WORKSPACE" Foreground="#9DA8C8" FontSize="11" CharacterSpacing="160"/>
                            <TextBlock Text="Your desktop, your atmosphere." Foreground="#F5F6FA" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Choose a LUMA wallpaper, then apply the appearance to your actual Windows desktop. Original settings are backed up for restoration." Foreground="#A8ADBC" FontSize="14" MaxWidth="680" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                        <Border Background="#202330" CornerRadius="18" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="WALLPAPER" Foreground="#9DA8C8" FontSize="10" CharacterSpacing="140"/>
                                <TextBlock x:Name="WallpaperStatusText" Text="No custom wallpaper selected." Foreground="#A8ADBC" FontSize="13" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Choose image" Click="ChooseWallpaper_Click"/>
                                    <Button Content="Remove wallpaper" Click="RemoveWallpaper_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Apply LUMA to Windows" Click="ApplyWindowsAppearance_Click"/>
                                    <Button Content="Restore previous appearance" Click="RestoreWindowsAppearance_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="WindowsAppearanceStatus" Text="Windows appearance has not been changed." Foreground="#858A9B" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="Applying changes the Windows wallpaper, dark app/system theme, and centered taskbar alignment. LUMA saves original values and restores them only when they have not been changed again by you." Foreground="#858A9B" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#202330" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="DESKTOP ITEMS" Foreground="#9DA8C8" FontSize="10" CharacterSpacing="130" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Refresh" Click="RefreshDesktop_Click"/>
                                </Grid>
                                <TextBlock x:Name="DesktopShortcutsStatus" Text="Loading desktop shortcuts..." Foreground="#A8ADBC" FontSize="12"/>
                                <ListView x:Name="DesktopItemsList" SelectionMode="None" MaxHeight="320" CanDragItems="True" CanReorderItems="True" DragItemsCompleted="DesktopItems_DragItemsCompleted">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/></ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="164" Margin="4" Spacing="4">
                                                <Button Content="{Binding Name}" Tag="{Binding FullPath}" Click="DesktopItem_Click" Height="58">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Open" Tag="{Binding FullPath}" Click="DesktopItemMenuOpen_Click"/>
                                                            <MenuFlyoutItem Text="Show in File Explorer" Tag="{Binding FullPath}" Click="DesktopItemReveal_Click"/>
                                                            <MenuFlyoutItem Text="Move left / up" Tag="{Binding FullPath}" Click="DesktopShortcutMoveUp_Click"/>
                                                            <MenuFlyoutItem Text="Move right / down" Tag="{Binding FullPath}" Click="DesktopShortcutMoveDown_Click"/>
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                </Button>
                                                <TextBlock Text="{Binding KindLabel}" Foreground="#858A9B" FontSize="9" HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                    <Button Content="↑" Tag="{Binding FullPath}" Click="DesktopShortcutMoveUp_Click" MinWidth="54"/>
                                                    <Button Content="↓" Tag="{Binding FullPath}" Click="DesktopShortcutMoveDown_Click" MinWidth="54"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Drag desktop items to reorder them. Folders open inside LUMA File Manager; files and shortcuts open with Windows default handlers. Hidden and system entries are excluded." Foreground="#858A9B" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1B1E29" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="DESKTOP LAYER" Foreground="#9DA8C8" FontSize="10" CharacterSpacing="130"/>
                                <TextBlock Text="Workspace preview is active" Foreground="#F5F6FA" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Native desktop icons, drag-and-drop placement, context menus, and live window integration will be added in subsequent milestones." Foreground="#A8ADBC" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="FilesPanel" Visibility="Collapsed" Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="FILE MANAGER" Foreground="#9DA8C8" FontSize="11" CharacterSpacing="160"/>
                            <TextBlock Text="Your files. One calm workspace." Foreground="#F5F6FA" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Browse folders, inspect file details, and open items with their Windows default applications. LUMA does not modify, move, or delete your files." Foreground="#A8ADBC" FontSize="14" MaxWidth="720" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Background="#202330" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="FilePathBox" PlaceholderText="Enter a folder path" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Go" Click="NavigateFilePath_Click"/>
                                    <Button Grid.Column="2" Content="Up" Click="FileParent_Click"/>
                                    <Button Grid.Column="3" Content="Choose folder" Click="ChooseFolder_Click"/>
                                </Grid>
                                <TextBlock x:Name="FileManagerStatus" Text="Choose a folder to begin." Foreground="#A8ADBC" FontSize="12"/>
                                <ListView x:Name="FileEntriesList" MaxHeight="560" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F5F6FA" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="#858A9B" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="#9DA8C8" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="Open" Tag="{Binding ShortcutPath}" Click="FileEntry_Open_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Read-only file operations in this milestone. No delete, rename, move, or overwrite actions are exposed." Foreground="#858A9B" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="WindowsPanel" Visibility="Collapsed" Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="WINDOW MANAGER" Foreground="#9DA8C8" FontSize="11" CharacterSpacing="160"/>
                            <TextBlock Text="Every open window, under control." Foreground="#F5F6FA" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Inspect visible desktop windows, bring an application forward, minimize it, or send a standard close request. LUMA never terminates another process." Foreground="#A8ADBC" FontSize="14" MaxWidth="720" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Background="#202330" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="OPEN WINDOWS" Foreground="#9DA8C8" FontSize="10" CharacterSpacing="140" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Refresh" Click="RefreshWindows_Click"/>
                                </Grid>
                                <TextBlock x:Name="WindowManagerStatus" Text="Window list has not been refreshed." Foreground="#A8ADBC" FontSize="12"/>
                                <ListView x:Name="WindowItemsList" MaxHeight="520" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="#F5F6FA" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProcessName}" Foreground="#858A9B" FontSize="10"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Focus" Tag="{Binding Handle}" Click="ActivateWindow_Click"/>
                                                <Button Grid.Column="2" Content="Minimize" Tag="{Binding Handle}" Click="MinimizeWindow_Click"/>
                                                <Button Grid.Column="3" Content="Close" Tag="{Binding Handle}" Click="CloseWindow_Click"/>
                                                <Button Grid.Column="4" Content="Left" Tag="{Binding Handle}" Click="SnapWindowLeft_Click"/>
                                                <Button Grid.Column="5" Content="Right" Tag="{Binding Handle}" Click="SnapWindowRight_Click"/>
                                                <Button Grid.Column="6" Content="Max" Tag="{Binding Handle}" Click="MaximizeWindow_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="OverviewPanel" Spacing="22">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="EyebrowText" Text="YOUR WINDOWS, REIMAGINED" Foreground="#9DA8C8" FontSize="11" CharacterSpacing="160"/>
                            <TextBlock x:Name="HeadingText" Text="A calmer way to work." Foreground="#F5F6FA" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DescriptionText" Text="LUMA is the foundation for a more coherent Windows desktop. This preview establishes the native shell host and its core navigation." Foreground="#A8ADBC" FontSize="15" MaxWidth="720" TextWrapping="Wrap" LineHeight="24"/>
                        </StackPanel>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1B1E29" CornerRadius="18" Padding="18">
                                <StackPanel Spacing="8"><TextBlock Text="01" Foreground="#9DA8C8" FontSize="12"/><TextBlock Text="Desktop" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Surface and workspace layer" Foreground="#9298AA" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#1B1E29" CornerRadius="18" Padding="18">
                                <StackPanel Spacing="8"><TextBlock Text="02" Foreground="#9DA8C8" FontSize="12"/><TextBlock Text="Dock" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Pinned and active apps" Foreground="#9298AA" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#1B1E29" CornerRadius="18" Padding="18">
                                <StackPanel Spacing="8"><TextBlock Text="03" Foreground="#9DA8C8" FontSize="12"/><TextBlock Text="Spotlight" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Search and quick actions" Foreground="#9298AA" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="#202330" CornerRadius="18" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="FOUNDATION MILESTONE" Foreground="#9DA8C8" FontSize="10" CharacterSpacing="140"/>
                                <TextBlock Text="Native shell host initialized" Foreground="#F5F6FA" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="The current build is an application preview. It does not replace Explorer, alter system startup, or take ownership of the Windows desktop." Foreground="#A8ADBC" FontSize="13" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="ApplicationsPanel" Visibility="Collapsed" Spacing="14">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="AppSearchBox" PlaceholderText="Search installed applications" TextChanged="AppSearch_TextChanged"/>
                            <Button Grid.Column="1" Content="Refresh" Click="RefreshApps_Click"/>
                        </Grid>
                        <ComboBox x:Name="AppCategoryFilter" PlaceholderText="All categories" SelectionChanged="AppCategory_SelectionChanged" Margin="0,0,0,4"/>
                        <TextBlock x:Name="AppsStatusText" Text="Discovering Start Menu shortcuts..." Foreground="#9298AA" FontSize="12"/>
                        <ListView x:Name="AppsList" Height="460" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="#F5F6FA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="Pin" Tag="{Binding ShortcutPath}" Click="PinApp_Click"/>
                                        <Button Grid.Column="2" Content="Open" Tag="{Binding ShortcutPath}" Click="LaunchApp_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="#191B24" CornerRadius="18" Margin="28,0,28,12" Padding="12,8" Visibility="Collapsed">
            <StackPanel Spacing="6">
                <TextBlock Text="DOCK" Foreground="#858A9B" FontSize="9" CharacterSpacing="130" HorizontalAlignment="Center"/>
                <ItemsControl x:Name="DockItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="3"><Button Content="{Binding Name}" Tag="{Binding ShortcutPath}" Click="DockApp_Click" MinWidth="76" MaxWidth="150"/><Button Content="×" Tag="{Binding ShortcutPath}" Click="UnpinDockApp_Click" MinWidth="30"/></StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="DockEmptyText" Text="Pin applications from the Applications section" Foreground="#777D8F" FontSize="10" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#191B24" Padding="20,10">
            <Grid>
                <TextBlock Text="LUMA • FOUNDATION" Foreground="#858A9B" FontSize="10" CharacterSpacing="100" VerticalAlignment="Center"/>
                <TextBlock Text="SAFE MODE  /  EXPLORER UNTOUCHED" Foreground="#7ED6B1" FontSize="10" CharacterSpacing="80" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid x:Name="SpotlightOverlay" Grid.RowSpan="4" Background="#B8101116" Visibility="Collapsed">
            <Border Width="560" MaxHeight="520" VerticalAlignment="Top" Margin="0,90,0,0" Background="#202330" CornerRadius="22" Padding="20">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="SPOTLIGHT" Foreground="#9DA8C8" FontSize="10" CharacterSpacing="150" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Close  Esc" Click="CloseSpotlight_Click"/>
                    </Grid>
                    <TextBox x:Name="SpotlightSearchBox" PlaceholderText="Search applications..." TextChanged="SpotlightSearch_TextChanged"/>
                    <TextBlock x:Name="SpotlightStatusText" Text="Search your Start Menu applications" Foreground="#9298AA" FontSize="11"/>
                    <ListView x:Name="SpotlightResults" MaxHeight="360" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="#F5F6FA" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Open" Tag="{Binding ShortcutPath}" Click="SpotlightLaunch_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
