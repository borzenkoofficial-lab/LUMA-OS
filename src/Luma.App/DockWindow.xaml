<Window
    x:Class="Luma.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LUMA Dock">
    <Grid Background="Transparent" Padding="2">
        <Border Background="#F01B1E29"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="25"
                Padding="10,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LumaButton"
                        Click="LumaButton_Click"
                        Background="#E8EAF4"
                        Foreground="#171923"
                        BorderThickness="0"
                        CornerRadius="15"
                        Padding="0"
                        Width="54"
                        Height="54"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Open LUMA">
                    <TextBlock Text="L"
                               FontSize="29"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                <Border Grid.Column="1"
                        Width="1"
                        Height="42"
                        Background="#35FFFFFF"
                        VerticalAlignment="Center"
                        Margin="1,0"/>
                <Grid Grid.Column="2">
                    <ItemsControl x:Name="DockItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding ShortcutPath}"
                                        Click="LaunchApp_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="3,0"
                                        MinWidth="60"
                                        Height="62"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Width="66"
                                                Spacing="3"
                                                HorizontalAlignment="Center">
                                        <Border Width="43"
                                                Height="43"
                                                CornerRadius="13"
                                                Background="#303747"
                                                BorderBrush="#30FFFFFF"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Initial}"
                                                       Foreground="#F4F5FA"
                                                       FontSize="21"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#E9EBF2"
                                                   FontSize="9"
                                                   MaxWidth="64"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyDockText"
                               Text="Pin your favorite apps in LUMA"
                               Foreground="#AEB4C4"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
