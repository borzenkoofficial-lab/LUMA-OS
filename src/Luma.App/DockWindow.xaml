<Window
    x:Class="Luma.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LUMA Dock">
    <Grid Background="Transparent">
        <Border Background="#F01B1E29"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="27"
                Padding="12,9"
                Margin="2">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LumaButton"
                        Click="LumaButton_Click"
                        PointerEntered="DockButton_PointerEntered"
                        PointerExited="DockButton_PointerExited"
                        Background="#E8EAF4"
                        Foreground="#171923"
                        BorderThickness="0"
                        CornerRadius="17"
                        Padding="0"
                        Width="58"
                        Height="58"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Open LUMA">
                    <TextBlock Text="L"
                               FontSize="31"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                <Border Grid.Column="1"
                        Width="1"
                        Height="48"
                        Background="#40FFFFFF"
                        VerticalAlignment="Center"
                        Margin="1,0"/>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LaunchpadButton" Grid.Column="0" Click="LaunchpadButton_Click"
                            PointerEntered="DockButton_PointerEntered"
                            PointerExited="DockButton_PointerExited"
                            Background="Transparent" BorderThickness="0" Padding="3,0"
                            Width="72" Height="76" AutomationProperties.Name="Open Launchpad">
                        <StackPanel Width="66" Spacing="3" HorizontalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="15"
                                    Background="#35435B" BorderBrush="#55FFFFFF" BorderThickness="1">
                                <Grid Padding="12">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Ellipse Fill="#F2F4FA" Margin="1"/>
                                    <Ellipse Grid.Column="1" Fill="#F2F4FA" Margin="1"/>
                                    <Ellipse Grid.Row="1" Fill="#F2F4FA" Margin="1"/>
                                    <Ellipse Grid.Row="1" Grid.Column="1" Fill="#F2F4FA" Margin="1"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Apps" Foreground="#E9EBF2" FontSize="10"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ItemsControl x:Name="DockItems" Grid.Column="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding ShortcutPath}"
                                        Click="LaunchApp_Click"
                                        PointerEntered="DockButton_PointerEntered"
                                        PointerExited="DockButton_PointerExited"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="3,0"
                                        MinWidth="72"
                                        Height="76"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Width="72"
                                                Spacing="4"
                                                HorizontalAlignment="Center">
                                        <Border Width="52"
                                                Height="52"
                                                CornerRadius="15"
                                                Background="#303747"
                                                BorderBrush="#40FFFFFF"
                                                BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="#F4F5FA"
                                                           FontSize="23"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Image Source="{Binding Icon}"
                                                       Width="48" Height="48"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#F1F2F7"
                                                   FontSize="10"
                                                   MaxWidth="70"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyDockText"
                               Text="Pin your favorite apps in LUMA"
                               Foreground="#B9C0D0"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
