<Window
    x:Class="Luma.App.MenuBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LUMA Menu Bar">
    <Border Background="#E9161922" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1">
        <Grid Padding="18,0" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="◈" FontSize="17" FontWeight="Bold" Padding="4,0"
                    Background="Transparent" BorderThickness="0" Foreground="#F5F6FA"
                    Click="Dashboard_Click" AutomationProperties.Name="LUMA menu"/>
            <TextBlock Grid.Column="1" Text="LUMA" FontSize="12" FontWeight="Bold"
                       Foreground="#F5F6FA" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Desktop" Click="Dashboard_Click"
                    Background="Transparent" BorderThickness="0" Foreground="#E5E8F0"
                    FontSize="11" Padding="8,3"/>
            <Button Grid.Column="3" Content="Apps" Click="Launchpad_Click"
                    Background="Transparent" BorderThickness="0" Foreground="#E5E8F0"
                    FontSize="11" Padding="8,3"/>
            <Button Grid.Column="4" Content="Search" Click="Spotlight_Click"
                    Background="Transparent" BorderThickness="0" Foreground="#E5E8F0"
                    FontSize="11" Padding="8,3"/>
            <Button Grid.Column="6" Content="☼  Control Center" Click="ControlCenter_Click"
                    Background="Transparent" BorderThickness="0" Foreground="#E5E8F0"
                    FontSize="11" Padding="8,3"/>
            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock x:Name="DateText" Foreground="#E5E8F0" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeText" Foreground="#FFFFFF" FontSize="11"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
