<Window
    x:Class="Luma.App.FileManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LUMA Finder">
    <Grid Background="#171A22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#20242F" Padding="14,20">
            <StackPanel Spacing="8">
                <TextBlock Text="FAVORITES" Foreground="#929DB8" FontSize="10"
                           CharacterSpacing="140" Margin="8,0,0,8"/>
                <Button Content="⌂   Home" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="Home_Click"/>
                <Button Content="▣   Desktop" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="Desktop_Click"/>
                <Button Content="↓   Downloads" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="Downloads_Click"/>
                <Button Content="▤   Documents" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="Documents_Click"/>
                <Button Content="▧   Pictures" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="Pictures_Click"/>
                <Border Height="1" Background="#363B49" Margin="8,14"/>
                <TextBlock Text="LOCATIONS" Foreground="#929DB8" FontSize="10"
                           CharacterSpacing="140" Margin="8,0,0,4"/>
                <Button Content="This PC" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="ThisPc_Click"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Padding="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="←" Width="38" Click="Back_Click"/>
                <Button Grid.Column="1" Content="↑" Width="38" Click="Up_Click"/>
                <TextBox x:Name="PathBox" Grid.Column="2" PlaceholderText="Folder path"
                         VerticalAlignment="Center" KeyDown="PathBox_KeyDown"/>
                <Button Grid.Column="3" Content="Choose folder" Click="ChooseFolder_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,20,0,12">
                <TextBlock x:Name="FolderTitle" Text="Home" Foreground="#F5F6FA"
                           FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Width="240" HorizontalAlignment="Right"
                         PlaceholderText="Search this folder" TextChanged="SearchBox_TextChanged"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="NAME" Foreground="#8791A8" FontSize="10"
                           CharacterSpacing="120" Margin="12,0"/>
                <TextBlock Grid.Column="1" Text="KIND" Foreground="#8791A8"
                           FontSize="10" CharacterSpacing="120"/>
            </Grid>
            <ListView x:Name="EntriesList" Grid.Row="3" IsItemClickEnabled="True"
                      ItemClick="EntriesList_ItemClick" SelectionMode="None"
                      Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,9" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Name}" Foreground="#F0F2F8"
                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Details}" Foreground="#8D96AA"
                                           FontSize="10" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                       Foreground="#AEB8D5" FontSize="10"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#8D96AA"
                       FontSize="10" Margin="2,12,0,0"/>
        </Grid>
    </Grid>
</Window>
