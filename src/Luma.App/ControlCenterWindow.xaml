<Window
    x:Class="Luma.App.ControlCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LUMA Control Center">
    <Border Background="#F01C202B" BorderBrush="#55FFFFFF" BorderThickness="1"
            CornerRadius="22" Padding="18">
        <StackPanel Spacing="14">
            <Grid>
                <StackPanel Spacing="3">
                    <TextBlock Text="CONTROL CENTER" Foreground="#AEB8D5"
                               FontSize="10" CharacterSpacing="160"/>
                    <TextBlock Text="Quick controls" Foreground="#F5F6FA"
                               FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Click="Close_Click"
                        Background="#303747" Foreground="#F5F6FA" BorderThickness="0"/>
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="#303747" CornerRadius="14" Padding="13">
                    <StackPanel Spacing="5">
                        <TextBlock Text="◉  Network" Foreground="#F5F6FA" FontSize="12"/>
                        <TextBlock x:Name="NetworkStatus" Text="Checking…" Foreground="#AEB4C4" FontSize="10"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#303747" CornerRadius="14" Padding="13">
                    <StackPanel Spacing="5">
                        <TextBlock Text="◐  Display" Foreground="#F5F6FA" FontSize="12"/>
                        <TextBlock Text="Windows display settings" Foreground="#AEB4C4" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="WINDOWS SETTINGS" Foreground="#9DA8C8"
                       FontSize="10" CharacterSpacing="140"/>
            <Button Content="Network &amp; Internet  →" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="Network_Click"/>
            <Button Content="Bluetooth &amp; devices  →" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="Bluetooth_Click"/>
            <Button Content="Display &amp; brightness  →" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="Display_Click"/>
            <Button Content="Sound settings  →" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="Sound_Click"/>
            <TextBlock Text="These controls open the corresponding native Windows settings. LUMA does not simulate hardware switches." 
                       Foreground="#858A9B" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
